{
	"name": "my-react-app",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"build:clients": "node scripts/build-clients.mjs",
		"test": "node --test tests/*.test.mjs",
		"test:builds": "node --test tests/builds.test.mjs",
		"test:all": "npm run lint && npm run build && npm run build:clients && npm test",
		"lint": "eslint .",
		"preview": "vite preview",
		"predeploy": "npm run build",
		"deploy": "gh-pages -d dist"
	},
	"dependencies": {
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-router-dom": "^7.18.7"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"eslint": "^10.13.0",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-refresh": "^0.5.7",
		"gh-pages": "^6.3.0",
		"globals": "^17.13.0",
		"vite": "^8.3.5"
	}
}
